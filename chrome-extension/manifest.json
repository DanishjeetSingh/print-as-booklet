{
  "manifest_version": 3,
  "name": "Print Current PDF as Booklet",
  "version": "1.0.0",
  "description": "Print the PDF in the active Chrome tab using the local macOS booklet workflow.",
  "key": "",
  "permissions": [
    "activeTab",
    "cookies",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Print current PDF as booklet"
  }
}
